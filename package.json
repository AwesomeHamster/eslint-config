{
  "name": "@hamster-bot/eslint-config",
  "version": "2.3.3",
  "description": "Common ESLint configuration used in Hamster",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MaikoTan/eslint-config.git"
  },
  "author": {
    "name": "Maiko Tan",
    "url": "https://github.com/MaikoTan",
    "email": "maiko.tan.coding@gmail.com"
  },
  "license": "CC-BY-NC-4.0",
  "type": "module",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": {
        "import": "./dist/index.d.ts"
      },
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "rollup -c rollup.config.ts --configPlugin @rollup/plugin-typescript",
    "lint": "eslint .",
    "prepublishOnly": "yarn build"
  },
  "prettier": "@hamster-bot/prettier-config",
  "dependencies": {
    "@eslint/js": "^9.39.2",
    "@stylistic/eslint-plugin": "^5.7.0",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import-x": "^4.16.1",
    "eslint-plugin-n": "^17.23.1",
    "eslint-plugin-promise": "^7.2.1",
    "globals": "^17.0.0",
    "typescript-eslint": "^8.52.0"
  },
  "devDependencies": {
    "@hamster-bot/prettier-config": "^1.0.2",
    "@rollup/plugin-commonjs": "^29.0.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-typescript": "^12.3.0",
    "eslint": "^9.39.2",
    "rollup": "^4.55.1",
    "tslib": "^2.8.1",
    "typescript": "^5.5.4"
  },
  "peerDependencies": {
    "eslint": "^8.34.0 || >=9.0.0"
  },
  "packageManager": "yarn@4.5.1"
}
